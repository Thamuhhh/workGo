{
  "expo": {
    "name": "Gigro",
    "slug": "workgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "scheme": "workgo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Splash (2).png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.anonymous.workgo",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Splash (2).png",
          "imageWidth": 1080,
          "resizeMode": "cover",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "./plugins/withAndroidSplashFull",
        {
          "image": "./assets/Splash (2).png"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/poppins/400Regular/Poppins_400Regular.ttf",
            "node_modules/@expo-google-fonts/poppins/500Medium/Poppins_500Medium.ttf",
            "node_modules/@expo-google-fonts/poppins/600SemiBold/Poppins_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/poppins/700Bold/Poppins_700Bold.ttf",
            "node_modules/@expo-google-fonts/poppins/800ExtraBold/Poppins_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gigro uses your location to show jobs hiring near you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": ["arm64-v8a"],
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
