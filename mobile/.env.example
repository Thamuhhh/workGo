# Backend API base URL
# The app has no fallback host. If this is unset every request fails with
# "Server address is not configured", so always set it.
#
# Release / physical device / production:
EXPO_PUBLIC_API_URL=https://workgo-production.up.railway.app/api/v1
#
# Dev only (never use these for a build you install on a phone):
#   Android Emulator: http://10.0.2.2:5000/api/v1
#   iOS Simulator:    http://127.0.0.1:5000/api/v1
#   Web:              http://127.0.0.1:5000/api/v1
#   Physical Device:  http://<YOUR_LOCAL_IP>:5000/api/v1

# MapTiler key for map tiles and geocoding
EXPO_PUBLIC_MAPTILER_KEY=
