# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# In local development without running MongoDB, server will use graceful fallback
MONGODB_URI=mongodb://localhost:27017/workgo

# Authentication
JWT_SECRET=workgo_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Firebase (phone auth ID token verification)
FIREBASE_PROJECT_ID=

# CORS
CLIENT_URL=http://localhost:3000
