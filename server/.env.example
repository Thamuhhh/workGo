# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# In local development without running MongoDB, server will use graceful fallback
MONGODB_URI=mongodb://localhost:27017/workgo

# Authentication
# REQUIRED in production — generate with: openssl rand -hex 48 (never commit a real secret)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Firebase (phone auth ID token verification)
FIREBASE_PROJECT_ID=

# CORS — comma-separated list of allowed browser origins.
# 8081 = Expo web dev server (mobile), 3000 = web client, 19006 = Expo dev client
CLIENT_URL=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Public hostname, used only for the startup banner. Set this in production so
# logs show the real URL instead of localhost. On Railway it is available as
# $RAILWAY_PUBLIC_DOMAIN, e.g. https://workgo-production.up.railway.app
PUBLIC_URL=
